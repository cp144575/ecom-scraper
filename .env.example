# Runtime uses the async engine.
# Default is async SQLite so the demo runs out-of-the-box.
DATABASE_URL=sqlite+aiosqlite:///ecom_scraper.db

# Alembic runs synchronously and uses this URL.
# For MySQL migrations use: mysql+pymysql://root:password@127.0.0.1:3306/ecom_scraper?charset=utf8mb4
SYNC_DATABASE_URL=sqlite:///ecom_scraper.db

# For the production MySQL path (async), set:
# DATABASE_URL=mysql+asyncmy://root:password@127.0.0.1:3306/ecom_scraper?charset=utf8mb4

# Redis (optional V2 queue/dedup backend)
REDIS_URL=redis://127.0.0.1:6379/0

LOG_LEVEL=INFO
REQUEST_TIMEOUT=10.0

# Concurrency: global and per-domain limits (separate from rate)
CONCURRENCY_GLOBAL=100
CONCURRENCY_DOMAIN_DEFAULT=20
QUEUE_MAXSIZE=0

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5
RETRY_JITTER=0.1

# Rate limit in requests/second per domain (0 = unlimited)
RATE_LIMIT_RPS=0
